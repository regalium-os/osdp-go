load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "schemadrift_lib",
    srcs = [
        "compare.go",
        "fbs.go",
        "ledger.go",
        "main.go",
        "proto.go",
        "schema.go",
        "verify.go",
    ],
    importpath = "github.com/regalium-os/osdp-go/tools/schemadrift",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "schemadrift",
    embed = [":schemadrift_lib"],
    visibility = ["//visibility:public"],
)

# Read as data by the conformance tests. keep
# keep
filegroup(
    name = "sources",
    srcs = glob(["**/*.go"]),
    visibility = ["//visibility:public"],
)

go_test(
    name = "schemadrift_test",
    srcs = [
        "detect_test.go",
        "drift_test.go",
    ],
    embed = [":schemadrift_lib"],
)
