load("@gazelle//:def.bzl", "gazelle")

# gazelle:prefix github.com/regalium-os/osdp-go
# gazelle:exclude protobuf/generated
gazelle(name = "gazelle")

gazelle(
    name = "gazelle-update-repos",
    args = [
        "-from_file=go.work",
        "-to_macro=deps.bzl%go_dependencies",
        "-prune",
    ],
    command = "update-repos",
)

# The source tree the architecture test inspects. go.work is included because
# the test locates the repository root by finding it.
filegroup(
    name = "layer_sources",
    srcs = [
        "go.work",
        "//bus:sources",
        "//cmd:sources",
        "//driver:sources",
        "//frame:sources",
        "//provider:sources",
        "//secure:sources",
        "//telemetry:sources",
        "//transport:sources",
    ],
    visibility = ["//visibility:public"],
)

# Everything the line-limit check measures: the layers, plus the internal and
# tools trees that are equally hand-written and equally subject to it.
filegroup(
    name = "all_go_sources",
    srcs = [
        ":layer_sources",
        "//internal/arch:sources",
        "//tools/schemadrift:sources",
    ],
    visibility = ["//visibility:public"],
)
