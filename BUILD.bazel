load("@gazelle//:def.bzl", "gazelle")
load("@rules_go//go:def.bzl", "go_library", "go_test")

# gazelle:prefix github.com/regalium-os/osdp-go
# gazelle:exclude flatbuffers/generated

# The whole protobuf tree, not merely its generated output: buf owns the schema
# module, and gazelle left to itself writes proto_library rules against
# @com_google_protobuf, which is not a bazel_dep here. Those rules break
# `bazel test //...` on the next `just tidy`, so the tree stays out of gazelle's
# reach until the schema module is genuinely part of the Bazel build.
# gazelle:exclude protobuf
gazelle(name = "gazelle")

# The source tree the conformance tests inspect. They read files rather than the
# build graph, so every tree they measure must be declared here; go.work is
# included because the tests locate the repository root by finding it.
filegroup(
    name = "all_go_sources",
    srcs = [
        "go.work",
        "osdp.go",
        "//internal/arch:sources",
        "//internal/bus:sources",
        "//internal/cmd:sources",
        "//internal/driver:sources",
        "//internal/frame:sources",
        "//internal/panel:sources",
        "//internal/provider:sources",
        "//internal/secure:sources",
        "//internal/transport:sources",
        "//telemetry:sources",
        "//tools/schemadrift:sources",
    ],
    visibility = ["//visibility:public"],
)

go_library(
    name = "osdp-go",
    srcs = [
        "bus.go",
        "commands.go",
        "osdp.go",
        "panel.go",
        "secure.go",
        "vendor.go",
    ],
    importpath = "github.com/regalium-os/osdp-go",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/bus",
        "//internal/cmd",
        "//internal/driver",
        "//internal/frame",
        "//internal/panel",
        "//internal/provider",
        "//internal/secure",
        "//internal/transport",
    ],
)

go_test(
    name = "osdp-go_test",
    srcs = [
        "capabilities_test.go",
        "e2e_test.go",
        "osdp_test.go",
        "panel_test.go",
        "secure_channel_test.go",
        "simulator_test.go",
    ],
    deps = [":osdp-go"],
)
