load("@rules_go//go:def.bzl", "go_test")

go_test(
    name = "arch_test",
    srcs = [
        "arch_test.go",
        "deps_test.go",
        "purity_test.go",
        "size_test.go",
        "support_test.go",
    ],
    # These tests read the repository's source files rather than its build
    # graph, so the sources must be declared as inputs and the test must run
    # from the workspace root. Without both, they run against an empty tree.
    # The `keep` directives stop Gazelle from pruning them on regeneration --
    # it has already done so once.
    # keep
    data = ["//:all_go_sources"],
    # keep
    rundir = ".",
)

# keep
filegroup(
    name = "sources",
    srcs = glob(["**/*.go"]),
    visibility = ["//visibility:public"],
)
