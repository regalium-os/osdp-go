load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "transport",
    srcs = [
        "doc.go",
        "port.go",
    ],
    importpath = "github.com/regalium-os/osdp-go/internal/transport",
    visibility = ["//:__subpackages__"],
)

