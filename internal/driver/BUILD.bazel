load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "driver",
    srcs = [
        "conn.go",
        "doc.go",
        "pipe.go",
        "serial.go",
        "serial_port.go",
        "serial_unix.go",
        "serial_unsupported.go",
        "tcp.go",
        "termios_darwin.go",
        "termios_linux.go",
        "termios_unix.go",
    ],
    importpath = "github.com/regalium-os/osdp-go/internal/driver",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/transport"],
)

# Read as data by the conformance tests; without it they would run blind.
# keep
filegroup(
    name = "sources",
    srcs = glob(["**/*.go"]),
    visibility = ["//visibility:public"],
)

go_test(
    name = "driver_test",
    srcs = [
        "driver_test.go",
        "ptyname_darwin_test.go",
        "ptyname_linux_test.go",
        "serial_pty_test.go",
        "serial_test.go",
    ],
    deps = [
        ":driver",
        "//internal/frame",
        "//internal/transport",
    ],
)
