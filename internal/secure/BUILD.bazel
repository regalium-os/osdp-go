load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "secure",
    srcs = [
        "aes128.go",
        "crypt.go",
        "doc.go",
        "errors.go",
        "handshake.go",
        "keys.go",
        "mac.go",
        "message.go",
        "scs.go",
        "session.go",
        "suite.go",
    ],
    importpath = "github.com/regalium-os/osdp-go/internal/secure",
    visibility = ["//:__subpackages__"],
)

# Read as data by the conformance tests; without it they would run blind.
# keep
filegroup(
    name = "sources",
    srcs = glob(["**/*.go"]),
    visibility = ["//visibility:public"],
)

go_test(
    name = "secure_test",
    srcs = [
        "crypt_test.go",
        "kat_test.go",
        "mac_test.go",
        "replay_test.go",
        "session_test.go",
        "suite_test.go",
    ],
    data = glob(["testdata/**"]),
    deps = [":secure"],
)
