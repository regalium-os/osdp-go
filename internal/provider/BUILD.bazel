load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "provider",
    srcs = [
        "capabilities.go",
        "doc.go",
        "generic.go",
        "provider.go",
        "registry.go",
        "vendor.go",
    ],
    importpath = "github.com/regalium-os/osdp-go/internal/provider",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/cmd"],
)

# Read as data by the conformance tests; without it they would run blind.
# keep
filegroup(
    name = "sources",
    srcs = glob(["**/*.go"]),
    visibility = ["//visibility:public"],
)

go_test(
    name = "provider_test",
    srcs = [
        "corpus_test.go",
        "fixture_test.go",
        "mfg_fixture_test.go",
        "provider_test.go",
    ],
    data = glob(["testdata/**"]),
    deps = [
        ":provider",
        "//internal/cmd",
        "//internal/frame",
    ],
)
