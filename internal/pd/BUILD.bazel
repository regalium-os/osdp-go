load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "pd",
    srcs = [
        "cache.go",
        "clock.go",
        "control.go",
        "device.go",
        "dispatch.go",
        "doc.go",
        "errors.go",
        "handle.go",
        "handler.go",
        "handshake.go",
        "identity.go",
        "options.go",
        "report.go",
        "scan.go",
        "sealed.go",
        "secure.go",
        "serve.go",
        "server.go",
        "serveroptions.go",
        "status.go",
    ],
    importpath = "github.com/regalium-os/osdp-go/internal/pd",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/cmd",
        "//internal/frame",
        "//internal/secure",
        "//internal/transport",
        "//telemetry",
    ],
)

go_test(
    name = "pd_test",
    srcs = [
        "cache_test.go",
        "comset_test.go",
        "contact_test.go",
        "device_test.go",
        "framing_test.go",
        "handle_test.go",
        "keyset_test.go",
        "output_test.go",
        "port_test.go",
        "queue_test.go",
        "report_test.go",
        "secure_failure_test.go",
        "secure_test.go",
        "secureframing_test.go",
        "securesupport_test.go",
        "sequence_test.go",
        "server_test.go",
        "silence_test.go",
        "support_test.go",
    ],
    deps = [
        ":pd",
        "//internal/cmd",
        "//internal/frame",
        "//internal/secure",
        "//internal/transport",
    ],
)

# Read as data by the conformance tests; without it they would run blind.
# keep
filegroup(
    name = "sources",
    srcs = glob(["**/*.go"]),
    visibility = ["//visibility:public"],
)
