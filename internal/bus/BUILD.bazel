load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "bus",
    srcs = [
        "bus.go",
        "device.go",
        "doc.go",
        "event.go",
        "options.go",
        "outbox.go",
        "reply.go",
        "seal.go",
        "secure.go",
        "session.go",
        "status.go",
    ],
    importpath = "github.com/regalium-os/osdp-go/internal/bus",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/cmd",
        "//internal/frame",
        "//internal/secure",
        "//internal/transport",
        "//telemetry",
    ],
)

# Read as data by the conformance tests; without it they would run blind.
# keep
filegroup(
    name = "sources",
    srcs = glob(["**/*.go"]),
    visibility = ["//visibility:public"],
)

go_test(
    name = "bus_test",
    srcs = [
        "bus_test.go",
        "compose_test.go",
        "framing_test.go",
        "lifecycle_test.go",
        "peripheral_test.go",
        "secure_failure_test.go",
        "secure_policy_test.go",
        "secure_test.go",
        "status_test.go",
    ],
    embed = [":bus"],
    deps = [
        "//internal/cmd",
        "//internal/frame",
        "//internal/secure",
        "//internal/transport",
    ],
)
