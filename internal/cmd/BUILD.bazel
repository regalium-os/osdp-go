load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "cmd",
    srcs = [
        "capabilities.go",
        "codes.go",
        "doc.go",
        "errors.go",
        "led.go",
        "message.go",
        "names.go",
        "output.go",
        "payloads.go",
        "status.go",
    ],
    importpath = "github.com/regalium-os/osdp-go/internal/cmd",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/frame",
        "//telemetry",
    ],
)

# Read as data by the conformance tests; without it they would run blind.
# keep
filegroup(
    name = "sources",
    srcs = glob(["**/*.go"]),
    visibility = ["//visibility:public"],
)

go_test(
    name = "cmd_test",
    srcs = [
        "capabilities_test.go",
        "commands_test.go",
    ],
    deps = [":cmd"],
)
